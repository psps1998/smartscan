ANTHROPIC_API_KEY=
PORT=3000

# Optional: only needed once, to upgrade an old single-user database (see CLAUDE.md "Accounts").
APP_USER=testscan
APP_PASSWORD=

# Admin dashboard (/admin). Leave ADMIN_PASSWORD empty to keep it disabled.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Email (activation + password reset). Production uses AWS SES SMTP (ap-south-1). With SMTP_HOST empty, mails are only logged (journal), not sent.
APP_URL=https://smartscan.in
MAIL_FROM="Smartscan <no-reply@smartscan.in>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Contact form: Google reCAPTCHA v2 ("I'm not a robot" checkbox) keys from https://www.google.com/recaptcha/admin.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
